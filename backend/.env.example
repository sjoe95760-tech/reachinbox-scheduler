# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Database (Postgres, matches docker-compose.yml) ---
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox"

# --- Redis (matches docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JS origin: http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- JWT (for our own session token issued after Google login) ---
JWT_SECRET=replace-this-with-a-long-random-string

# --- Ethereal Email (fake SMTP for testing) ---
# Get free test creds instantly at https://ethereal.email/create
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_USER=your-ethereal-user@ethereal.email
ETHEREAL_SMTP_PASS=your-ethereal-password

# --- Rate limiting & concurrency (all configurable, no hardcoding) ---
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
